/*
 * Use a repository-local work directory by default so the pipeline
 * can run on systems where /workspace is not writable. Allow users
 * to override via NXF_WORK if they need a custom location.
 */
def resolvedWorkDir = System.getenv('NXF_WORK') ?: "${baseDir}/work"
workDir = resolvedWorkDir

process {
    cache = 'deep'
}
