{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Summary Metadata Schema",
  "type": "object",
  "required": [
    "modelEntityId",
    "latestVersion",
    "providerId",
    "isComplex",
    "uniprotAccession",
    "uniprotDescription",
    "isUniProtReferenceProteome",
    "isUniProtReviewed",
    "isIsoform",
    "organismScientificName",
    "taxId",
    "globalMetricValue",
    "isAMdata"
  ],
  "properties": {
    "modelEntityId": {
      "type": "string",
      "pattern": "^AF-[0-9]{16}$"
    },
    "latestVersion": {
      "type": "integer",
      "minimum": 1
    },
    "providerId": {
      "type": "string"
    },
    "isComplex": {
      "type": "boolean"
    },
    "complexName": {
      "type": ["string", "null"]
    },
    "assemblyType": {
      "type": ["string", "null"],
      "enum": ["Homo", "Hetero", null]
    },
    "oligomericState": {
      "type": ["string", "null"]
    },
    "oligomericStateDescription": {
      "type": ["string", "null"]
    },
    "complexComposition": {
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]+_[1-9][0-9]*$"
      },
      "minItems": 1
    },
    "uniprotAccession": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "uniprotAccession_display": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "uniprotDescription": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "uniprotDescription_display": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "isUniProtReferenceProteome": {
      "type": "boolean"
    },
    "isUniProtReviewed": {
      "type": "boolean"
    },
    "isIsoform": {
      "type": "boolean"
    },
    "organismScientificName": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "organismScientificName_display": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "gene": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      },
      "minItems": 1
    },
    "gene_display": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "taxId": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 1
    },
    "taxId_display": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 1
    },
    "sequenceStart": {
      "type": "integer",
      "minimum": 1
    },
    "sequenceEnd": {
      "type": "integer",
      "minimum": 1
    },
    "globalMetricValue": {
      "type": "number"
    },
    "isAMdata": {
      "type": "boolean"
    },
    "_version_": {
      "type": "integer"
    }
  },
  "patternProperties": {
    "^complexPredictionAccuracy_[A-Za-z0-9_]+$": {
      "type": ["number", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "isComplex": { "const": true } },
        "required": ["isComplex"]
      },
      "then": {
        "required": [
          "complexName",
          "assemblyType",
          "oligomericState",
          "oligomericStateDescription",
          "complexPredictionAccuracy_ipTM",
          "complexPredictionAccuracy_ipsae_pae_cutoff",
          "complexPredictionAccuracy_ipsae_dist_cutoff",
          "complexPredictionAccuracy_iptm_af",
          "complexPredictionAccuracy_ipsae_AB",
          "complexPredictionAccuracy_ipsae_BA",
          "complexPredictionAccuracy_ipsae_d0chn_AB",
          "complexPredictionAccuracy_ipsae_d0chn_BA",
          "complexPredictionAccuracy_ipsae_d0dom_AB",
          "complexPredictionAccuracy_ipsae_d0dom_BA",
          "complexPredictionAccuracy_ipsae_iptm_d0chn_AB",
          "complexPredictionAccuracy_ipsae_iptm_d0chn_BA",
          "complexPredictionAccuracy_pDockQ2_AB",
          "complexPredictionAccuracy_pDockQ2_BA",
          "complexPredictionAccuracy_LIS_AB",
          "complexPredictionAccuracy_LIS_BA",
          "complexPredictionAccuracy_ipsae_n0res_AB",
          "complexPredictionAccuracy_ipsae_n0res_BA",
          "complexPredictionAccuracy_ipsae_n0dom_AB",
          "complexPredictionAccuracy_ipsae_n0dom_BA",
          "complexPredictionAccuracy_ipsae_d0res_AB",
          "complexPredictionAccuracy_ipsae_d0res_BA",
          "complexPredictionAccuracy_ipsae_nres1_AB",
          "complexPredictionAccuracy_ipsae_nres1_BA",
          "complexPredictionAccuracy_ipsae_nres2_AB",
          "complexPredictionAccuracy_ipsae_nres2_BA",
          "complexPredictionAccuracy_ipsae_dist_nres1_AB",
          "complexPredictionAccuracy_ipsae_dist_nres1_BA",
          "complexPredictionAccuracy_ipsae_dist_nres2_AB",
          "complexPredictionAccuracy_ipsae_dist_nres2_BA",
          "complexPredictionAccuracy_pDockQ",
          "complexPredictionAccuracy_ipsae_n0chn"
        ]
      }
    }
  ],
  "additionalProperties": false
}
