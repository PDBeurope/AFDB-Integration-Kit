{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "uniqueId",
    "toolUsed",
    "modelCreatedDate",
    "modelEntityId",
    "isComplex",
    "sequence",
    "sequenceChecksum",
    "sequenceStart",
    "sequenceEnd",
    "isIsoform",
    "isFragment",
    "isUniProt",
    "isUniProtReferenceProteome",
    "isUniProtReviewed",
    "globalMetricValue",
    "fractionPlddtVeryLow",
    "fractionPlddtLow",
    "fractionPlddtConfident",
    "fractionPlddtVeryHigh",
    "latestVersion",
    "allVersions",
    "providerId",
    "entityType",
    "isAMdata"
  ],
  "properties": {
    "uniqueId": {
      "type": "string",
      "pattern": "^AF-[0-9]{16}_v[1-9][0-9]*_[A-Za-z0-9]+$"
    },
    "toolUsed": {
      "type": "string",
      "minLength": 1
    },
    "modelCreatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "modelEntityId": {
      "type": "string",
      "pattern": "^AF-[0-9]{16}$"
    },
    "isComplex": {
      "type": "boolean"
    },
    "numberOfInteractions": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of inter-chain interface interactions for a complex."
    },
    "complexName": {
      "type": "string",
      "minLength": 1
    },
    "uniprotAccession": {
      "type": "string",
      "minLength": 1
    },
    "uniprotId": {
      "type": "string",
      "minLength": 1
    },
    "uniprotDescription": {
      "type": "string",
      "minLength": 1
    },
    "gene": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "geneSynonyms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "taxId": {
      "type": "integer",
      "minimum": 1
    },
    "organismScientificName": {
      "type": "string"
    },
    "organismScientificNameT": {
      "type": [
        "string",
        "null"
      ]
    },
    "organismCommonNames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "organismSynonyms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assemblyType": {
      "type": "string",
      "enum": [
        "Homo",
        "Hetero"
      ]
    },
    "oligomericState": {
      "type": "string",
      "enum": [
        "monomer",
        "dimer",
        "trimer",
        "tetramer",
        "pentamer",
        "hexamer",
        "heptamer",
        "octamer",
        "nonamer",
        "decamer",
        "oligomer"
      ]
    },
    "oligomericStateDescription": {
      "type": [
        "string",
        "null"
      ]
    },
    "sequence": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z]+$"
    },
    "sequenceChecksum": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{32}$"
    },
    "sequenceVersionDate": {
      "type": "string",
      "format": "date-time"
    },
    "sequenceStart": {
      "type": "integer",
      "minimum": 1
    },
    "sequenceEnd": {
      "type": "integer",
      "minimum": 1
    },
    "isIsoform": {
      "type": "boolean"
    },
    "isFragment": {
      "type": "boolean"
    },
    "isUniProt": {
      "type": "boolean"
    },
    "isUniProtReferenceProteome": {
      "type": "boolean"
    },
    "isUniProtReviewed": {
      "type": "boolean"
    },
    "globalMetricValue": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "fractionPlddtVeryLow": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "fractionPlddtLow": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "fractionPlddtConfident": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "fractionPlddtVeryHigh": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "latestVersion": {
      "type": "integer",
      "minimum": 1
    },
    "allVersions": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "entityType": {
      "type": "string",
      "minLength": 1
    },
    "isAMdata": {
      "type": "boolean"
    },
    "complexComposition": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9-]+_[1-9][0-9]*(,[A-Za-z0-9-]+_[1-9][0-9]*)*$"
    },
    "_version_": {
      "type": "integer"
    },
    "complexPredictionAccuracy_ipTM": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  },
  "patternProperties": {
    "^complexPredictionAccuracy_[A-Za-z0-9_]+$": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "isComplex": {
            "const": true
          }
        },
        "required": [
          "isComplex"
        ]
      },
      "then": {
        "required": [
          "complexComposition",
          "complexPredictionAccuracy_ipTM",
          "complexPredictionAccuracy_ipsae_pae_cutoff",
          "complexPredictionAccuracy_ipsae_dist_cutoff",
          "complexPredictionAccuracy_iptm_af",
          "complexPredictionAccuracy_pDockQ",
          "complexPredictionAccuracy_ipsae_n0chn"
        ],
        "properties": {
          "complexName": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "patternProperties": {
          "^complexPredictionAccuracy_": false
        },
        "properties": {
          "assemblyType": {
            "type": "null"
          },
          "oligomericState": {
            "type": "null"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "complexComposition"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "isUniProt": {
            "const": true
          }
        },
        "required": [
          "isUniProt"
        ]
      },
      "then": {
        "required": [
          "uniprotAccession",
          "uniprotId",
          "uniprotDescription",
          "taxId",
          "organismScientificName",
          "sequenceVersionDate"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "uniprotAccession"
              ]
            },
            {
              "required": [
                "uniprotId"
              ]
            },
            {
              "required": [
                "uniprotDescription"
              ]
            }
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
