{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Entity Schema",
  "type": "object",
  "required": [
    "uniqueId",
    "toolUsed",
    "modelCreatedDate",
    "modelEntityId",
    "stoichiometry",
    "providerId",
    "entityType",
    "sequence",
    "sequenceChecksum",
    "sequenceStart",
    "sequenceEnd",
    "isUniProt",
    "globalMetricValue",
    "fractionPlddtVeryLow",
    "fractionPlddtLow",
    "fractionPlddtConfident",
    "fractionPlddtVeryHigh",
    "latestVersion",
    "allVersions"
  ],
  "properties": {
    "uniqueId": {
      "type": "string",
      "description": "Unique ID for the entity, must be modelEntityId + '_' + ordinal number",
      "examples": ["AF-1000000000000001-v1_1"]
    },
    "toolUsed": {
      "type": "string",
      "description": "Tool used for prediction",
      "examples": ["AlphaFold Monomer v2.0 pipeline"]
    },
    "modelCreatedDate": {
      "type": "string",
      "format": "date-time",
      "description": "Date the model was created in YYYY-MM-DDT00:00:00Z format (ISO 8601)",
      "examples": ["2023-05-01T00:00:00Z"]
    },
    "modelEntityId": {
      "type": "string",
      "description": "Unique model entity identifier as per the defined convention",
      "examples": ["AF-1000000000000001-v1"]
    },
    "complexName": {
      "type": ["string", "null"],
      "description": "Name of the complex",
      "examples": ["Hemoglobin Tetramer"]
    },
    "complexComposition": {
      "type": ["string", "null"],
      "description": "Comma-separated list of components in the format <sequenceChecksum>_<stoichiometry>",
      "examples": ["408C22731C6EDFBE_2,A8B880A25617EC96_1"]
    },
    "uniprotAccession": {
      "type": ["string", "null"],
      "description": "UniProt accession",
      "examples": ["P12345"]
    },
    "uniprotId": {
      "type": ["string", "null"],
      "description": "UniProt identifier",
      "examples": ["HBA_HUMAN"]
    },
    "uniprotDescription": {
      "type": ["string", "null"],
      "description": "Description of the protein in UniProt",
      "examples": ["Hemoglobin subunit alpha"]
    },
    "geneSynonyms": {
      "type": ["array", "null"],
      "description": "List of gene synonyms (strings)",
      "items": { "type": "string" },
      "examples": [["HBA1", "HB1", "Alpha-globin"]]
    },
    "gene": {
      "type": ["string", "null"],
      "description": "Gene name (string)",
      "examples": ["HBA"]
    },
    "isUniProtReferenceProteome": {
      "type": ["boolean", "null"],
      "description": "Boolean flag for UniProt reference proteome",
      "examples": [true]
    },
    "isUniProtReviewed": {
      "type": ["boolean", "null"],
      "description": "Boolean flag for UniProt curation status",
      "examples": [true]
    },
    "taxId": {
      "type": ["integer", "null"],
      "description": "NCBI Taxonomy ID",
      "examples": [9606]
    },
    "organismScientificName": {
      "type": ["string", "null"],
      "description": "Scientific name of the organism",
      "examples": ["Homo sapiens"]
    },
    "otherTaxIds": {
      "type": ["array", "null"],
      "description": "List of NCBI Taxonomy IDs representing additional taxa associated with the sequence",
      "items": { "type": "integer" },
      "examples": [[9606, 9615]]
    },
    "otherOrganismScientificNames": {
      "type": ["array", "null"],
      "description": "List of scientific names corresponding to the otherTaxIds (must match order)",
      "items": { "type": "string" },
      "examples": [["Homo sapiens", "Canis lupus familiaris"]]
    },
    "stoichiometry": {
      "type": "integer",
      "description": "Number of entity copies (integer)",
      "examples": [2]
    },
    "oligomericStateDescription": {
      "type": ["string", "null"],
      "description": "Combined assembly type and oligomeric state for a complex",
      "examples": ["Heterodimer"]
    },
    "ipTM": {
      "type": ["number", "null"],
      "description": "Quality metric (float)",
      "examples": [0.85]
    },
    "ipSAE": {
      "type": ["number", "null"],
      "description": "Quality metric (float)",
      "examples": [0.12]
    },
    "providerId": {
      "type": "string",
      "description": "Provider ID assigned by EBI",
      "examples": ["AF-EBI-001"]
    },
    "entityType": {
      "type": "string",
      "description": "Type of entity (e.g., protein, ligand)",
      "examples": ["protein"]
    },
    "sequence": {
      "type": "string",
      "description": "Protein sequence",
      "examples": ["MVLSPADKTNVKAAWGKVGAHAGEYGAEALERMFLSFPTTKTYFPHF"]
    },
    "sequenceChecksum": {
      "type": "string",
      "description": "MD5 checksum of the sequence. Required if sourced from UniProt or reference DB",
      "examples": ["408C22731C6EDFBE"]
    },
    "sequenceVersionDate": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Sequence version date in YYYY-MM-DDT00:00:00Z format (ISO 8601)",
      "examples": ["2022-01-10T00:00:00Z"]
    },
    "sequenceStart": {
      "type": "integer",
      "description": "Starting residue index (integer)",
      "examples": [1]
    },
    "sequenceEnd": {
      "type": "integer",
      "description": "Ending residue index (integer)",
      "examples": [142]
    },
    "isFragment": {
      "type": ["boolean", "null"],
      "description": "Boolean indicating whether the sequence is a fragment",
      "examples": [false]
    },
    "isUniProt": {
      "type": "boolean",
      "description": "Boolean indicating if the sequence is from UniProt",
      "examples": [true]
    },
    "globalMetricValue": {
      "type": "number",
      "description": "Average pLDDT (float)",
      "examples": [92.5]
    },
    "fractionPlddtVeryLow": {
      "type": "number",
      "description": "Fraction of residues with very low confidence",
      "examples": [0.01]
    },
    "fractionPlddtLow": {
      "type": "number",
      "description": "Fraction of residues with low confidence",
      "examples": [0.05]
    },
    "fractionPlddtConfident": {
      "type": "number",
      "description": "Fraction of residues with confident prediction",
      "examples": [0.6]
    },
    "fractionPlddtVeryHigh": {
      "type": "number",
      "description": "Fraction of residues with very high confidence",
      "examples": [0.34]
    },
    "organismCommonNames": {
      "type": ["array", "null"],
      "description": "List of common names of the organism, including those for otherOrganismScientificNames",
      "items": { "type": "string" },
      "examples": [["human", "dog"]]
    },
    "organismSynonyms": {
      "type": ["array", "null"],
      "description": "List of synonyms of the organism, including those for otherOrganismScientificNames",
      "items": { "type": "string" },
      "examples": [["H. sapiens", "C. lupus familiaris"]]
    },
    "proteinFullNames": {
      "type": ["array", "null"],
      "description": "Full names of the protein",
      "items": { "type": "string" },
      "examples": [["Hemoglobin subunit alpha"]]
    },
    "proteinShortNames": {
      "type": ["array", "null"],
      "description": "Short names of the protein",
      "items": { "type": "string" },
      "examples": [["HbA"]]
    },
    "keywords": {
      "type": ["array", "null"],
      "description": "List of descriptive keywords (from UniProt XML)",
      "items": { "type": "string" },
      "examples": [["oxygen transport", "heme-binding"]]
    },
    "taxonomyLineage": {
      "type": ["array", "null"],
      "description": "List of taxonomy lineage terms (from UniProt XML)",
      "items": { "type": "string" },
      "examples": [["Eukaryota", "Metazoa", "Chordata", "Mammalia"]]
    },
    "functions": {
      "type": ["array", "null"],
      "description": "List of functions (from UniProt XML)",
      "items": { "type": "string" },
      "examples": [["Oxygen transport from the lungs to body tissues"]]
    },
    "alternativeNames": {
      "type": ["array", "null"],
      "description": "List of alternative protein names (from UniProt XML)",
      "items": { "type": "string" },
      "examples": [["Alpha-globin"]]
    },
    "catalyticActivities": {
      "type": ["array", "null"],
      "description": "List of catalytic activities (from UniProt XML)",
      "items": { "type": "string" },
      "examples": [["EC 1.1.1.1 - alcohol dehydrogenase activity"]]
    },
    "latestVersion": {
      "type": "integer",
      "description": "Current version number (integer)",
      "examples": [3]
    },
    "allVersions": {
      "type": "array",
      "description": "List of all version numbers (integers)",
      "items": { "type": "integer" },
      "examples": [[1, 2, 3]]
    }
  },
  "additionalProperties": false
}
