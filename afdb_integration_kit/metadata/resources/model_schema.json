{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Metadata Summary Schema",
  "type": "object",
  "required": [
    "modelEntityId",
    "latestVersion",
    "providerId",
    "isComplex",
    "uniprotAccession",
    "uniprotDescription",
    "isUniProtReferenceProteome",
    "isUniProtReviewed",
    "isIsoform",
    "organismScientificName",
    "gene",
    "taxId",
    "globalMetricValue",
    "isAMdata"
  ],
  "properties": {
    "modelEntityId": {
      "type": "string",
      "description": "Unique model entity identifier.",
      "pattern": "^AF-[0-9]{16}$",
      "examples": ["AF-1000000000000001"]
    },
    "latestVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Current version number.",
      "examples": [1]
    },
    "providerId": {
      "type": "string",
      "description": "Provider ID assigned by EBI.",
      "examples": ["AF-EBI-001"]
    },
    "isComplex": {
      "type": "boolean",
      "description": "Whether the model represents a complex."
    },
    "complexName": {
      "type": ["string", "null"],
      "description": "Name of the complex.",
      "examples": ["Complex of Cytochrome P450/Large subunit ribosomal protein L3"]
    },
    "assemblyType": {
      "type": ["string", "null"],
      "enum": ["Homo", "Hetero", null],
      "description": "Assembly type for complex models."
    },
    "oligomericState": {
      "type": ["string", "null"],
      "description": "Oligomeric state for complex models.",
      "examples": ["dimer"]
    },
    "complexComposition": {
      "type": ["array", "null"],
      "description": "Complex components in '<accession>_<stoichiometry>' form.",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]+_[1-9][0-9]*$"
      },
      "minItems": 1,
      "examples": [["A0ABS2QMZ4_1", "A0ABS2QMF5_1"]]
    },
    "oligomericStateDescription": {
      "type": ["string", "null"],
      "description": "Human-readable oligomeric state description.",
      "examples": ["Heterodimer"]
    },
    "uniprotAccession": {
      "type": "array",
      "description": "UniProt accessions represented by the model.",
      "items": { "type": "string" },
      "minItems": 1,
      "examples": [["O00400"]]
    },
    "uniprotDescription": {
      "type": "array",
      "description": "UniProt descriptions represented by the model.",
      "items": { "type": "string" },
      "minItems": 1,
      "examples": [["Acetyl-coenzyme A transporter 1"]]
    },
    "isUniProtReferenceProteome": {
      "type": "boolean",
      "description": "Whether the represented UniProt entries are from a reference proteome."
    },
    "isUniProtReviewed": {
      "type": "boolean",
      "description": "Whether the represented UniProt entries are reviewed."
    },
    "isIsoform": {
      "type": "boolean",
      "description": "Whether the represented entries are isoforms."
    },
    "organismScientificName": {
      "type": "array",
      "description": "Scientific organism names represented by the model.",
      "items": { "type": "string" },
      "minItems": 1,
      "examples": [["Homo sapiens (Human)"]]
    },
    "gene": {
      "type": "array",
      "description": "Gene names represented by the model.",
      "items": { "type": "string" },
      "minItems": 1,
      "examples": [["SLC33A1"]]
    },
    "taxId": {
      "type": "array",
      "description": "NCBI taxonomy IDs represented by the model.",
      "items": { "type": "integer" },
      "minItems": 1,
      "examples": [[9606]]
    },
    "sequenceStart": {
      "type": "integer",
      "minimum": 1,
      "description": "Starting residue index for single-sequence summaries.",
      "examples": [1]
    },
    "sequenceEnd": {
      "type": "integer",
      "minimum": 1,
      "description": "Ending residue index for single-sequence summaries.",
      "examples": [549]
    },
    "globalMetricValue": {
      "type": "number",
      "description": "Average pLDDT or equivalent global confidence metric.",
      "examples": [81.38]
    },
    "complexPredictionAccuracy_ipTM": {
      "type": ["number", "null"],
      "description": "ipTM value for complex predictions.",
      "examples": [0.16]
    },
    "isAMdata": {
      "type": "boolean",
      "description": "Whether this is AlphaMissense data."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "isComplex": { "const": true } },
        "required": ["isComplex"]
      },
      "then": {
        "required": [
          "complexName",
          "assemblyType",
          "oligomericState",
          "complexComposition",
          "oligomericStateDescription"
        ]
      }
    },
    {
      "if": {
        "properties": { "isComplex": { "const": false } },
        "required": ["isComplex"]
      },
      "then": {
        "required": ["sequenceStart", "sequenceEnd"]
      }
    }
  ],
  "additionalProperties": false
}
